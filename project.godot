; Engine configuration file.
; Day One Patch — a Code Crusader story. Vertical slice.

config_version=5

[application]

config/name="Day One Patch"
config/description="Satirical co-op FPS vertical slice (Studio 1: Saccharine Toddler Inc.)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

Data="*res://scripts/autoload/data.gd"
Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/autoload/net.gd"
CombatBus="*res://scripts/autoload/combat_bus.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
